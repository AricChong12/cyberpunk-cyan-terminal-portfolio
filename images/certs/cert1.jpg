<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <radialGradient id="cyberGlow_OSCP" cx="50%" cy="50%" r="60%">
      <stop offset="0%" stop-color="#00f0ff" stop-opacity="0.18"/>
      <stop offset="100%" stop-color="#050508" stop-opacity="1"/>
    </radialGradient>
    <pattern id="grid_OSCP" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#00f0ff" stroke-width="0.75" stroke-opacity="0.12"/>
      <circle cx="40" cy="40" r="1.5" fill="#00f0ff" fill-opacity="0.25"/>
    </pattern>
    <filter id="neon_OSCP" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  <!-- Background -->
  <rect width="1200" height="675" fill="#050508"/>
  <rect width="1200" height="675" fill="url(#cyberGlow_OSCP)"/>
  <rect width="1200" height="675" fill="url(#grid_OSCP)"/>

  <!-- Cyber frame -->
  <rect x="25" y="25" width="1150" height="625" fill="none" stroke="#0891a0" stroke-width="1.5" stroke-dasharray="16 8" opacity="0.6"/>
  <rect x="35" y="35" width="1130" height="605" fill="none" stroke="#00f0ff" stroke-width="1" opacity="0.3"/>

  <!-- Corner Brackets -->
  <path d="M 20 60 L 20 20 L 60 20" fill="none" stroke="#00f0ff" stroke-width="3"/>
  <path d="M 1180 60 L 1180 20 L 1140 20" fill="none" stroke="#00f0ff" stroke-width="3"/>
  <path d="M 20 615 L 20 655 L 60 655" fill="none" stroke="#00f0ff" stroke-width="3"/>
  <path d="M 1180 615 L 1180 655 L 1140 655" fill="none" stroke="#00f0ff" stroke-width="3"/>

  <!-- Top bar HUD telemetry -->
  <text x="50" y="65" fill="#00f0ff" font-family="'Share Tech Mono', monospace" font-size="14" letter-spacing="2">SYS.NODE // 0x7E1A // TELEMETRY: ACTIVE</text>
  <text x="1150" y="65" fill="#ff2a6d" font-family="'Share Tech Mono', monospace" font-size="14" text-anchor="end" letter-spacing="2">SEC_LEVEL // ENCRYPTED_GCM</text>

  <!-- Center Graphic elements -->
  <g transform="translate(600, 317.5)">
    <circle r="120" fill="none" stroke="#00f0ff" stroke-width="1.5" stroke-dasharray="8 6" opacity="0.5"/>
    <circle r="90" fill="none" stroke="#0891a0" stroke-width="1" opacity="0.7"/>
    <circle r="60" fill="#00f0ff" fill-opacity="0.08" stroke="#00f0ff" stroke-width="2" filter="url(#neon_OSCP)"/>
    <!-- Crosshairs -->
    <line x1="-150" y1="0" x2="-80" y2="0" stroke="#00f0ff" stroke-width="1.5" opacity="0.6"/>
    <line x1="80" y1="0" x2="150" y2="0" stroke="#00f0ff" stroke-width="1.5" opacity="0.6"/>
    <line x1="0" y1="-150" x2="0" y2="-80" stroke="#00f0ff" stroke-width="1.5" opacity="0.6"/>
    <line x1="0" y1="80" x2="0" y2="150" stroke="#00f0ff" stroke-width="1.5" opacity="0.6"/>
    <!-- Center badge text -->
    <text x="0" y="8" fill="#00f0ff" font-family="'Orbitron', monospace" font-size="22" font-weight="900" text-anchor="middle" filter="url(#neon_OSCP)">OSCP</text>
  </g>

  <!-- Title & Subtitle -->
  <text x="600" y="565" fill="#00f0ff" font-family="'Orbitron', monospace" font-size="32" font-weight="bold" text-anchor="middle" letter-spacing="3" filter="url(#neon_OSCP)">OFFENSIVE SECURITY</text>
  <text x="600" y="605" fill="#88a8b8" font-family="'Share Tech Mono', monospace" font-size="18" text-anchor="middle" letter-spacing="1">OSCP — Penetration Testing with Kali Linux</text>

  <!-- Bottom decorative bar -->
  <line x1="100" y1="635" x2="1100" y2="635" stroke="#00f0ff" stroke-width="1" opacity="0.4"/>
</svg>