<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <radialGradient id="cyberGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#00f0ff" stop-opacity="0.25"/>
      <stop offset="100%" stop-color="#050508" stop-opacity="1"/>
    </radialGradient>
    <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#00f0ff" stroke-width="0.5" stroke-opacity="0.15"/>
    </pattern>
    <filter id="neon" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  <rect width="600" height="600" fill="#050508"/>
  <rect width="600" height="600" fill="url(#grid)"/>
  <circle cx="300" cy="300" r="240" fill="url(#cyberGlow)"/>
  
  <!-- Outer reticles -->
  <circle cx="300" cy="300" r="220" fill="none" stroke="#00f0ff" stroke-width="1.5" stroke-dasharray="12 8" opacity="0.6"/>
  <circle cx="300" cy="300" r="180" fill="none" stroke="#0891a0" stroke-width="1" stroke-dasharray="4 6" opacity="0.5"/>
  <circle cx="300" cy="300" r="140" fill="none" stroke="#00f0ff" stroke-width="2" opacity="0.8"/>
  
  <!-- Cyber Avatar Silhouette -->
  <g fill="#00f0ff" opacity="0.85" filter="url(#neon)">
    <!-- Head -->
    <path d="M 300 170 C 260 170 235 200 235 240 C 235 275 260 300 280 310 L 280 330 L 320 330 L 320 310 C 340 300 365 275 365 240 C 365 200 340 170 300 170 Z" fill="#0a1924" stroke="#00f0ff" stroke-width="2"/>
    <!-- Cyber Visor / Glasses -->
    <polygon points="255,230 345,230 340,250 260,250" fill="#00f0ff" opacity="0.9"/>
    <line x1="240" y1="240" x2="360" y2="240" stroke="#ff2a6d" stroke-width="2"/>
    <!-- Shoulders -->
    <path d="M 210 420 C 220 350 260 340 280 335 L 320 335 C 340 340 380 350 390 420 Z" fill="#0c202d" stroke="#00f0ff" stroke-width="2"/>
  </g>

  <!-- HUD overlay text -->
  <text x="300" y="470" fill="#00f0ff" font-family="'Orbitron', monospace" font-size="18" font-weight="bold" text-anchor="middle" filter="url(#neon)">SUBJECT: [MY NAME]</text>
  <text x="300" y="500" fill="#88a8b8" font-family="'Share Tech Mono', monospace" font-size="14" text-anchor="middle">STATUS: BIOMETRICS VERIFIED // SYS_ADMIN</text>
  <text x="300" y="525" fill="#00f0ff" font-family="'Share Tech Mono', monospace" font-size="12" text-anchor="middle" opacity="0.8">CLEARANCE: LEVEL_5_ROOT // ID: #00-7702-X</text>

  <!-- Corner Brackets -->
  <path d="M 30 60 L 30 30 L 60 30" fill="none" stroke="#00f0ff" stroke-width="3"/>
  <path d="M 570 60 L 570 30 L 540 30" fill="none" stroke="#00f0ff" stroke-width="3"/>
  <path d="M 30 540 L 30 570 L 60 570" fill="none" stroke="#00f0ff" stroke-width="3"/>
  <path d="M 570 540 L 570 570 L 540 570" fill="none" stroke="#00f0ff" stroke-width="3"/>
</svg>